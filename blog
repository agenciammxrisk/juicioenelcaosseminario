        .panel{background: linear-gradient(180deg, #151515, #121212);padding:22px;border-radius:10px;border:1px solid rgba(255,255,255,0.03)}
        .tag{display:inline-block;padding:6px 10px;border-radius:999px;font-size:0.72rem;color:#bdbdbd;background:rgba(255,255,255,0.02);text-transform:uppercase;letter-spacing:1.6px}

        h2{font-size:1.5rem;margin:8px 0 12px;color:#ffffff}
        p{color:#d0d0d0;font-size:1rem;margin-bottom:12px}
        .muted{color:#9a9a9a}

        .blog-grid{display:flex;flex-direction:column;gap:16px;margin-top:20px}
        .post-card{
            background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.015));
            padding:24px;
            border-radius:10px;
            border:1px solid rgba(255,255,255,0.03);
            transition: border-color 0.2s ease;
        }
        .post-card:hover{border-color:rgba(255,255,255,0.1)}
        .post-title{font-family:'Playfair Display', serif;font-size:1.4rem;color:#ffffff;text-decoration:none;margin-bottom:6px;display:block}
        .post-title:hover{color:#cfcfcf}
        .post-meta{font-size:0.8rem;color:#9a9a9a;margin-bottom:12px;display:block}
        .read-more{display:inline-block;color:#ffffff;font-size:0.9rem;font-weight:600;text-decoration:none;margin-top:8px}
        .read-more:hover{text-decoration:underline}

        /* responsive */
        @media(max-width:800px){
            .wrap{padding:20px}
            h1{font-size:1.9rem}
            .main-nav{gap:8px}
            .main-nav a{padding:8px 10px;font-size:0.9rem}
        }
    </style>
</head>
