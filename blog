            font-weight:700;
            font-size:2.6rem;
            color:#ffffff;
            line-height:1.05;
            margin-bottom:6px;
        }
        .subtitle{color:#cfcfcf;font-size:1.05rem;max-width:72ch;font-weight:300}

        /* NAVIGATION */
        .main-nav{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0}
        .main-nav a{color:#dcdcdc;text-decoration:none;padding:8px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.03);background:transparent;font-weight:600;font-size:0.95rem}
        .main-nav a:hover{background:rgba(255,255,255,0.03)}
        .main-nav a.active{background:#ffffff;color:#0d0d0d}

        hr.sep{border:none;border-top:1px solid rgba(255,255,255,0.04);margin:36px 0}

